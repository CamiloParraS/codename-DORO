# Godot 4+ specific ignores
.godot/
/android/
.nomedia

# Godot 4.2+ specific ignores
~*.dll

# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg
*.tmp

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json

# Export outputs
*.exe
# Uncomment if your project does not version PCK files as runtime dependencies.
# *.pck

# Raw asset downloads (licenses forbid redistribution; copy used files into assets/)
_raw/

# LimboAI: only Windows binaries are vendored (Windows export only)
addons/limboai/bin/*android*
addons/limboai/bin/*ios*
addons/limboai/bin/*linux*
addons/limboai/bin/*macos*
addons/limboai/bin/*web*

# Mixamo-derived animation bake (their terms forbid redistribution); rebuild with tools/bake_mixamo.gd
assets/models/animations/mixamo_clips.res
assets/models/animations/target_clips.res

# Export output
build/
