#!/bin/sh
# Every staged .gd carries its .uid (Godot writes it on import; a missing one blocks merges in other worktrees).
# Enable once per clone: git config core.hooksPath .githooks
for f in $(git diff --cached --name-only --diff-filter=A -- '*.gd' | grep -v '^addons/'); do
  git ls-files --cached --error-unmatch "$f.uid" >/dev/null 2>&1 || {
    echo "pre-commit: stage $f.uid too (run godot --headless --path . --import)" >&2; exit 1; }
done

# Our scripts aim for 500 lines and stop at 600 (addons/ is third-party). Split along a real seam, not at a count.
for f in $(git diff --cached --name-only --diff-filter=AM -- '*.gd' | grep -v '^addons/'); do
  n=$(git show ":$f" | wc -l)
  [ "$n" -gt 600 ] && { echo "pre-commit: $f is $n lines; split it below 600 (aim for 500)" >&2; exit 1; }
done

# Scripts, scenes and text still parse and the suite is green (~1 min). It runs on the staged content in a temp
# checkout, so other unstaged edits and untracked files neither break nor rescue it. Skipped when nothing runnable
# is staged; `SKIP_CHECKS=1 git commit` bypasses it.
[ -n "$SKIP_CHECKS" ] && exit 0
git diff --cached --name-only | grep -Eq '\.(gd|tscn|tres|csv|gdshader)$' || exit 0
command -v godot >/dev/null 2>&1 || { echo "pre-commit: godot not on PATH, skipping the suite" >&2; exit 0; }
main=$(git rev-parse --show-toplevel)
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
git checkout-index --all --prefix="$tmp/"
cp -rp "$main/.godot" "$tmp/"  # the import cache, times kept, so only changed files reimport
git ls-files --others --ignored --exclude-standard -- '*.res' | grep -v '^\.claude/' | while read -r f; do  # baked clips
  mkdir -p "$tmp/$(dirname "$f")"; cp -p "$f" "$tmp/$f"
done
# A staged script that leans on an unstaged or untracked file (an icon, a const) fails here: stage it too.
out=$(timeout 300 godot --headless --path "$tmp" --import 2>&1; timeout 600 godot --headless --path "$tmp" tools/run_tests.tscn 2>&1 \
  || echo "FAIL the suite failed, crashed or ran past 10 minutes")
bad=$(printf '%s\n' "$out" | grep -E 'Parse Error|Compile Error|SCRIPT ERROR|^FAIL |^passed [0-9]+ failed [1-9]')
if [ -n "$bad" ]; then
  echo "pre-commit: scripts or tests are broken in the staged tree (SKIP_CHECKS=1 to bypass):" >&2
  printf '%s\n' "$bad" | head -15 >&2
  exit 1
fi
